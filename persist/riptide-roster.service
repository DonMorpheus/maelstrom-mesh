[Unit]
Description=Riptide overlay roster (loopback + wg0)
After=network-online.target wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/riptide/rosterd.py --roster /etc/riptide/roster.json --cache /var/cache/riptide --port 7668
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
